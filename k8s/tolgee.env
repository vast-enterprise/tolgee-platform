# Non-sensitive runtime configuration for the DEV deployment.
# Generate the ConfigMap from this file; never put credentials here.
SPRING_PROFILES_ACTIVE=docker
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
TOLGEE_FILE_STORAGE_FS_DATA_PATH=/data
TOLGEE_AUTHENTICATION_ENABLED=true
TOLGEE_AUTHENTICATION_NATIVE_ENABLED=true
TOLGEE_AUTHENTICATION_REGISTRATIONS_ALLOWED=true
TOLGEE_SMTP_HOST=smtp.feishu.cn
TOLGEE_SMTP_PORT=465
TOLGEE_SMTP_AUTH=true
TOLGEE_SMTP_SSL_ENABLED=true
TOLGEE_SMTP_TLS_ENABLED=false
TOLGEE_SMTP_TLS_REQUIRED=false
TOLGEE_SMTP_FROM=Tolgee <luonan@vastai3d.com>
